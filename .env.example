# Application
APP_ENV=production
APP_URL=http://localhost
HTTP_PORT=80

# Frontend (CRA build-time; empty = same-origin API via nginx)
REACT_APP_API_BASE_URL=

# PostgreSQL (service name inside Docker network — not localhost)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=portfolio_db
DB_USER=portfolio
DB_PASSWORD=change_me_strong_password
